demo/**/*.o
demo/iepro_demo
demo/build/iepro_demo
*.elf
*.bin.tmp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Toolchain (developers download separately — don't commit binaries)
/opt/
toolchain/*
!toolchain/README.md
!toolchain/README.zh-CN.md
*.tar.gz
